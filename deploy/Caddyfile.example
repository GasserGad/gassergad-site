# Example Caddy site block for the personal site.
# Replace APP1_PORT / APP2_PORT with the local ports your apps listen on.

www.example.com {
	redir https://example.com{uri} permanent
}

example.com {
	root * /srv/gassergad-site
	encode zstd gzip

	# Health checks used by the "live" dots on the project cards
	handle /status/compenstation {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:APP1_PORT
	}
	handle /status/h2h {
		rewrite * /healthz
		reverse_proxy 127.0.0.1:APP2_PORT
	}

	handle {
		# Don't serve repo files
		@hidden path /.git* /deploy/* /*.md
		respond @hidden 404
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@static path /vendor/* /fonts/* /css/* /js/*
	header @static Cache-Control "public, max-age=3600"
}
